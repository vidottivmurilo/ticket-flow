unit uTicketFlow;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Buttons, RESTRequest4D, System.JSON;

type
  TformTicketFlow = class(TForm)
    edtGuiche: TEdit;
    lblGuiche: TLabel;
    lblSenhaChamada: TLabel;
    lblTituloSenhaChamada: TLabel;
    sbtnChamarSenha: TSpeedButton;
    procedure sbtnChamarSenhaClick(Sender: TObject);
  private
    procedure ChamarSenha(guiche: string);
  end;

var
  formTicketFlow: TformTicketFlow;

implementation


{$R *.dfm}

{ TformTicketFlow }

procedure TformTicketFlow.ChamarSenha(guiche: string);
var
  LResponse: IResponse;
  LBody: string;
  LJson: TJSONObject; // Variável para o JSON
begin
  LBody := '{"guiche": ' + guiche + '}';
  try
    LResponse := TRequest.New.BaseURL('http://localhost:3000')
      .Resource('tickets/chamar')
      .Accept('application/json')
      .AddBody(LBody)
      .Post;

    // Se a API retornou 200 (Sucesso), extraímos a senha do JSON!
    if LResponse.StatusCode = 200 then
    begin
      LJson := TJSONObject.ParseJSONValue(LResponse.Content) as TJSONObject;
      try
        // Pegamos o valor numérico de "senha" que a API retornou
        lblSenhaChamada.Caption := LJson.GetValue<Integer>('senha').ToString;
      finally
        LJson.Free; // Sempre libere da memória
      end;
    end

    // Se a API retornou 404 (Fila Vazia), pegamos o erro do JSON!
    else if LResponse.StatusCode = 404 then
    begin
      LJson := TJSONObject.ParseJSONValue(LResponse.Content) as TJSONObject;
      try
        // Pegamos a string do campo "error"
        ShowMessage(LJson.GetValue<string>('error'));
      finally
        LJson.Free;
      end;
    end

    // Se for outro erro, exibe genericamente
    else
    begin
      ShowMessage('Erro Inesperado: ' + LResponse.Content);
    end;

  except
    Result := 'Erro ao conectar com o servidor!'
  end;

end;

procedure TformTicketFlow.sbtnChamarSenhaClick(Sender: TObject);
var
  guiche: string;
begin
  guiche := edtGuiche.Text;

  if guiche = '' then begin
    ShowMessage('É necessário informar um guichê!');
    edtGuiche.SetFocus;
    Exit;
  end;

  ChamarSenha(guiche);

end;

end.
