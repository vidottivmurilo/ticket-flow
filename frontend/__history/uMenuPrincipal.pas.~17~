unit uMenuPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, uTicketMonitor, uTicketTotem, uTicketAtendente;

type
  TfrmPrincipal = class(TForm)
    btnModuloTotem: TButton;
    btnModuloAtendimento: TButton;
    btnModuloTV: TButton;
    procedure btnModuloTotemClick(Sender: TObject);
    procedure btnModuloAtendimentoClick(Sender: TObject);
    procedure btnModuloTVClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmPrincipal: TfrmPrincipal;

implementation

{$R *.dfm}

procedure TfrmPrincipal.btnModuloAtendimentoClick(Sender: TObject);
var
  frmAtendimento: TformTicketAtendente;
begin
  frmAtendimento := TformTicketAtendente.Create(Self);
  frmAtendimento.Show;
  frmAtendimento.Free;
end;

procedure TfrmPrincipal.btnModuloTotemClick(Sender: TObject);
var
  frmTotem: TformTicketTotem;
begin
  frmTotem := TformTicketTotem.Create(Self);
  frmTotem.Show;
  frmTotem.Free;
end;

procedure TfrmPrincipal.btnModuloTVClick(Sender: TObject);
var
  frmMonitor: TformTicketMonitor;
begin
  frmMonitor := TformTicketMonitor.Create(Self);
  frmMonitor.Show;
  frmMonitor.Free;
end;

end.
